# -----------------------------------------------------------------------------
# NEXORA ERP - Environment Variables Configuration
# -----------------------------------------------------------------------------

# PostgreSQL Database Connection
# Local Docker: postgresql://postgres:postgres@localhost:5432/nexora_erp?schema=public
# Cloud (Neon/Supabase/RDS): postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexora_erp?schema=public"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication & Session Secrets (Generate with `openssl rand -base64 32`)
AUTH_SECRET="nexora-erp-super-secret-jwt-token-replace-in-production-min32chars"
NEXTAUTH_URL="http://localhost:3000"

# Application Configuration
NEXT_PUBLIC_APP_NAME="NEXORA ERP"
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"
NEXT_PUBLIC_DEFAULT_CURRENCY_SYMBOL="$"

# Audit and Security
SESSION_MAX_AGE_SECONDS=86400
BCRYPT_SALT_ROUNDS=10
