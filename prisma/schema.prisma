datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// Enums
// ----------------------------------------------------

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  FINANCE
  SALES
  PURCHASING
  WAREHOUSE
  HR
  READ_ONLY
}

enum DocumentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  CONFIRMED
  PROCESSING
  PARTIALLY_DELIVERED
  DELIVERED
  PARTIALLY_RECEIVED
  RECEIVED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REJECTED
}

enum StockMovementType {
  RECEIPT
  ISSUE
  TRANSFER
  ADJUSTMENT
}

enum StockMovementReferenceType {
  PURCHASE_RECEIPT
  SALES_DELIVERY
  MANUAL_ADJUSTMENT
  TRANSFER
  RETURN
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHECK
  CREDIT_CARD
  ELECTRONIC
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountSubType {
  CURRENT_ASSET
  CASH_AND_BANK
  ACCOUNTS_RECEIVABLE
  INVENTORY
  FIXED_ASSET
  CURRENT_LIABILITY
  ACCOUNTS_PAYABLE
  LONG_TERM_LIABILITY
  EQUITY_CAPITAL
  RETAINED_EARNINGS
  OPERATING_REVENUE
  SALES_DISCOUNT
  COST_OF_GOODS_SOLD
  OPERATING_EXPENSE
  ADMINISTRATIVE_EXPENSE
  TAX_EXPENSE
  OTHER_INCOME_EXPENSE
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum EmploymentStatus {
  PERMANENT
  PROBATION
  CONTRACT
  INTERN
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  ON_LEAVE
  HALF_DAY
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  UNPAID
  EMERGENCY
  SPECIAL
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ----------------------------------------------------
// Multi-Tenancy & Core Access
// ----------------------------------------------------

model Company {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  code             String   @unique
  address          String?
  city             String?
  state            String?
  country          String   @default("United States")
  postalCode       String?
  phone            String?
  email            String?
  website          String?
  taxId            String?
  currency         String   @default("USD")
  currencySymbol   String   @default("$")
  fiscalYearStart  Int      @default(1) // Month (1 = Jan)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  memberships       CompanyMembership[]
  auditLogs         AuditLog[]
  documentSequences DocumentSequence[]
  departments       Department[]
  employees         Employee[]
  customers         Customer[]
  suppliers         Supplier[]
  productCategories ProductCategory[]
  unitsOfMeasure    UnitOfMeasure[]
  products          Product[]
  warehouses        Warehouse[]
  stockBalances     StockBalance[]
  stockMovements    StockMovement[]
  quotations        Quotation[]
  salesOrders       SalesOrder[]
  deliveries        Delivery[]
  customerInvoices  CustomerInvoice[]
  customerPayments  CustomerPayment[]
  purchaseRequests  PurchaseRequest[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  supplierBills     SupplierBill[]
  supplierPayments  SupplierPayment[]
  accounts          Account[]
  journalEntries    JournalEntry[]
  expenses          Expense[]
  attendanceRecords AttendanceRecord[]
  leaveRequests     LeaveRequest[]

  @@map("companies")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   CompanyMembership[]
  auditLogs     AuditLog[]
  employees     Employee[]

  @@map("users")
}

model CompanyMembership {
  id         String   @id @default(uuid())
  userId     String
  companyId  String
  role       Role     @default(READ_ONLY)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
  @@map("company_memberships")
}

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String
  userId     String?
  action     String   // e.g. CREATE, UPDATE, DELETE, POST, APPROVE
  entity     String   // e.g. SalesOrder, StockMovement, CustomerInvoice
  entityId   String?
  details    String?  // JSON string of changes
  ipAddress  String?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, entity])
  @@index([companyId, createdAt])
  @@map("audit_logs")
}

model DocumentSequence {
  id           String @id @default(uuid())
  companyId    String
  documentType String // e.g. SO, INV, PO, GR, BILL, PAY, JE, MOV, REQ, QUO
  prefix       String
  nextNumber   Int    @default(1)
  padding      Int    @default(5)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, documentType])
  @@map("document_sequences")
}

// ----------------------------------------------------
// Master Data: Inventory & Products
// ----------------------------------------------------

model ProductCategory {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  code        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("product_categories")
}

model UnitOfMeasure {
  id        String   @id @default(uuid())
  companyId String
  name      String
  symbol    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, symbol])
  @@index([companyId])
  @@map("units_of_measure")
}

model Product {
  id            String   @id @default(uuid())
  companyId     String
  sku           String
  barcode       String?
  name          String
  description   String?
  categoryId    String?
  uomId         String?
  costPrice     Decimal  @default(0.00) @db.Decimal(15, 2)
  sellingPrice  Decimal  @default(0.00) @db.Decimal(15, 2)
  minStockLevel Decimal  @default(0.00) @db.Decimal(12, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company            Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category           ProductCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  uom                UnitOfMeasure?          @relation(fields: [uomId], references: [id], onDelete: SetNull)
  stockBalances      StockBalance[]
  stockMovements     StockMovement[]
  quotationItems     QuotationItem[]
  salesOrderItems    SalesOrderItem[]
  deliveryItems      DeliveryItem[]
  invoiceItems       CustomerInvoiceItem[]
  purchaseReqItems   PurchaseRequestItem[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  supplierBillItems  SupplierBillItem[]

  @@unique([companyId, sku])
  @@index([companyId, isActive])
  @@index([companyId, categoryId])
  @@map("products")
}

model Warehouse {
  id        String   @id @default(uuid())
  companyId String
  code      String
  name      String
  location  String?
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockBalances  StockBalance[]
  stockMovements StockMovement[] @relation("SourceWarehouse")
  destMovements  StockMovement[] @relation("TargetWarehouse")
  deliveries     Delivery[]
  goodsReceipts  GoodsReceipt[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("warehouses")
}

model StockBalance {
  id               String   @id @default(uuid())
  companyId        String
  productId        String
  warehouseId      String
  quantity         Decimal  @default(0.00) @db.Decimal(12, 2)
  reservedQuantity Decimal  @default(0.00) @db.Decimal(12, 2)
  updatedAt        DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([companyId, productId, warehouseId])
  @@index([companyId, productId])
  @@index([companyId, warehouseId])
  @@map("stock_balances")
}

model StockMovement {
  id             String                     @id @default(uuid())
  companyId      String
  movementNumber String
  movementType   StockMovementType
  productId      String
  warehouseId    String
  toWarehouseId  String?
  quantity       Decimal                    @db.Decimal(12, 2)
  unitCost       Decimal                    @default(0.00) @db.Decimal(15, 2)
  totalCost      Decimal                    @default(0.00) @db.Decimal(15, 2)
  referenceType  StockMovementReferenceType
  referenceId    String?
  notes          String?
  createdById    String?
  createdAt      DateTime                   @default(now())

  company         Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product         Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse       Warehouse  @relation("SourceWarehouse", fields: [warehouseId], references: [id], onDelete: Cascade)
  targetWarehouse Warehouse? @relation("TargetWarehouse", fields: [toWarehouseId], references: [id], onDelete: SetNull)

  @@unique([companyId, movementNumber])
  @@index([companyId, productId])
  @@index([companyId, warehouseId])
  @@index([companyId, createdAt])
  @@map("stock_movements")
}

// ----------------------------------------------------
// Sales Module
// ----------------------------------------------------

model Customer {
  id               String   @id @default(uuid())
  companyId        String
  code             String
  name             String
  email            String?
  phone            String?
  address          String?
  city             String?
  state            String?
  taxNumber        String?
  creditLimit      Decimal  @default(0.00) @db.Decimal(15, 2)
  paymentTermsDays Int      @default(30)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotations       Quotation[]
  salesOrders      SalesOrder[]
  deliveries       Delivery[]
  customerInvoices CustomerInvoice[]
  customerPayments CustomerPayment[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("customers")
}

model Quotation {
  id              String         @id @default(uuid())
  companyId       String
  quotationNumber String
  customerId      String
  status          DocumentStatus @default(DRAFT)
  issueDate       DateTime       @default(now())
  validUntil      DateTime
  subtotal        Decimal        @default(0.00) @db.Decimal(15, 2)
  taxRate         Decimal        @default(0.00) @db.Decimal(5, 2)
  taxAmount       Decimal        @default(0.00) @db.Decimal(15, 2)
  discountAmount  Decimal        @default(0.00) @db.Decimal(15, 2)
  totalAmount     Decimal        @default(0.00) @db.Decimal(15, 2)
  notes           String?
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items       QuotationItem[]
  salesOrders SalesOrder[]

  @@unique([companyId, quotationNumber])
  @@index([companyId, customerId])
  @@index([companyId, status])
  @@map("quotations")
}

model QuotationItem {
  id          String  @id @default(uuid())
  quotationId String
  productId   String
  description String?
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(15, 2)
  discount    Decimal @default(0.00) @db.Decimal(15, 2)
  total       Decimal @db.Decimal(15, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("quotation_items")
}

model SalesOrder {
  id                   String         @id @default(uuid())
  companyId            String
  orderNumber          String
  quotationId          String?
  customerId           String
  status               DocumentStatus @default(DRAFT)
  orderDate            DateTime       @default(now())
  expectedDeliveryDate DateTime?
  subtotal             Decimal        @default(0.00) @db.Decimal(15, 2)
  taxRate              Decimal        @default(0.00) @db.Decimal(5, 2)
  taxAmount            Decimal        @default(0.00) @db.Decimal(15, 2)
  discountAmount       Decimal        @default(0.00) @db.Decimal(15, 2)
  totalAmount          Decimal        @default(0.00) @db.Decimal(15, 2)
  notes                String?
  createdById          String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation  Quotation?            @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  items      SalesOrderItem[]
  deliveries Delivery[]
  invoices   CustomerInvoice[]

  @@unique([companyId, orderNumber])
  @@index([companyId, customerId])
  @@index([companyId, status])
  @@map("sales_orders")
}

model SalesOrderItem {
  id               String  @id @default(uuid())
  salesOrderId     String
  productId        String
  description      String?
  quantity         Decimal @db.Decimal(12, 2)
  deliveredQuantity Decimal @default(0.00) @db.Decimal(12, 2)
  invoicedQuantity  Decimal @default(0.00) @db.Decimal(12, 2)
  unitPrice        Decimal @db.Decimal(15, 2)
  discount         Decimal @default(0.00) @db.Decimal(15, 2)
  total            Decimal @db.Decimal(15, 2)

  salesOrder    SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  deliveryItems DeliveryItem[]

  @@map("sales_order_items")
}

model Delivery {
  id             String         @id @default(uuid())
  companyId      String
  deliveryNumber String
  salesOrderId   String
  customerId     String
  warehouseId    String
  status         DocumentStatus @default(CONFIRMED)
  deliveryDate   DateTime       @default(now())
  trackingNumber String?
  notes          String?
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesOrder SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouse  Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items      DeliveryItem[]

  @@unique([companyId, deliveryNumber])
  @@index([companyId, salesOrderId])
  @@map("deliveries")
}

model DeliveryItem {
  id               String  @id @default(uuid())
  deliveryId       String
  salesOrderItemId String
  productId        String
  quantity         Decimal @db.Decimal(12, 2)

  delivery       Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id], onDelete: Restrict)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("delivery_items")
}

model CustomerInvoice {
  id                String         @id @default(uuid())
  companyId         String
  invoiceNumber     String
  salesOrderId      String?
  customerId        String
  status            DocumentStatus @default(DRAFT)
  issueDate         DateTime       @default(now())
  dueDate           DateTime
  subtotal          Decimal        @default(0.00) @db.Decimal(15, 2)
  taxRate           Decimal        @default(0.00) @db.Decimal(5, 2)
  taxAmount         Decimal        @default(0.00) @db.Decimal(15, 2)
  discountAmount    Decimal        @default(0.00) @db.Decimal(15, 2)
  totalAmount       Decimal        @default(0.00) @db.Decimal(15, 2)
  paidAmount        Decimal        @default(0.00) @db.Decimal(15, 2)
  outstandingAmount Decimal        @default(0.00) @db.Decimal(15, 2)
  notes             String?
  createdById       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  company  Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrder SalesOrder?         @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  items    CustomerInvoiceItem[]
  payments CustomerPayment[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, customerId])
  @@index([companyId, status])
  @@index([companyId, dueDate])
  @@map("customer_invoices")
}

model CustomerInvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  productId   String
  description String?
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(15, 2)
  discount    Decimal @default(0.00) @db.Decimal(15, 2)
  total       Decimal @db.Decimal(15, 2)

  invoice CustomerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("customer_invoice_items")
}

model CustomerPayment {
  id              String        @id @default(uuid())
  companyId       String
  paymentNumber   String
  invoiceId       String
  customerId      String
  paymentMethod   PaymentMethod @default(BANK_TRANSFER)
  paymentDate     DateTime      @default(now())
  amount          Decimal       @db.Decimal(15, 2)
  referenceNumber String?
  notes           String?
  createdById     String?
  createdAt       DateTime      @default(now())

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice  CustomerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([companyId, paymentNumber])
  @@index([companyId, invoiceId])
  @@index([companyId, customerId])
  @@map("customer_payments")
}

// ----------------------------------------------------
// Purchasing & Suppliers Module
// ----------------------------------------------------

model Supplier {
  id               String   @id @default(uuid())
  companyId        String
  code             String
  name             String
  email            String?
  phone            String?
  address          String?
  city             String?
  taxNumber        String?
  paymentTermsDays Int      @default(30)
  bankAccount      String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]
  supplierBills    SupplierBill[]
  supplierPayments SupplierPayment[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("suppliers")
}

model PurchaseRequest {
  id             String         @id @default(uuid())
  companyId      String
  requestNumber  String
  departmentId   String?
  requestedById  String?
  status         DocumentStatus @default(DRAFT)
  requestDate    DateTime       @default(now())
  requiredDate   DateTime?
  estimatedTotal Decimal        @default(0.00) @db.Decimal(15, 2)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company        Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department     Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  items          PurchaseRequestItem[]
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, requestNumber])
  @@index([companyId, status])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                String  @id @default(uuid())
  purchaseRequestId String
  productId         String
  quantity          Decimal @db.Decimal(12, 2)
  estimatedCost     Decimal @default(0.00) @db.Decimal(15, 2)

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("purchase_request_items")
}

model PurchaseOrder {
  id                String         @id @default(uuid())
  companyId         String
  poNumber          String
  supplierId        String
  purchaseRequestId String?
  status            DocumentStatus @default(DRAFT)
  orderDate         DateTime       @default(now())
  expectedDate      DateTime?
  subtotal          Decimal        @default(0.00) @db.Decimal(15, 2)
  taxRate           Decimal        @default(0.00) @db.Decimal(5, 2)
  taxAmount         Decimal        @default(0.00) @db.Decimal(15, 2)
  totalAmount       Decimal        @default(0.00) @db.Decimal(15, 2)
  notes             String?
  createdById       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier        Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseRequest PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  items           PurchaseOrderItem[]
  goodsReceipts   GoodsReceipt[]
  bills           SupplierBill[]

  @@unique([companyId, poNumber])
  @@index([companyId, supplierId])
  @@index([companyId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String  @id @default(uuid())
  purchaseOrderId   String
  productId         String
  description       String?
  quantity          Decimal @db.Decimal(12, 2)
  receivedQuantity  Decimal @default(0.00) @db.Decimal(12, 2)
  billedQuantity    Decimal @default(0.00) @db.Decimal(12, 2)
  unitCost          Decimal @db.Decimal(15, 2)
  total             Decimal @db.Decimal(15, 2)

  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  goodsReceiptItems GoodsReceiptItem[]

  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String         @id @default(uuid())
  companyId       String
  receiptNumber   String
  purchaseOrderId String
  supplierId      String
  warehouseId     String
  status          DocumentStatus @default(CONFIRMED)
  receiptDate     DateTime       @default(now())
  notes           String?
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  supplier      Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items         GoodsReceiptItem[]

  @@unique([companyId, receiptNumber])
  @@index([companyId, purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String  @id @default(uuid())
  goodsReceiptId      String
  purchaseOrderItemId String
  productId           String
  quantityReceived    Decimal @db.Decimal(12, 2)
  unitCost            Decimal @db.Decimal(15, 2)

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("goods_receipt_items")
}

model SupplierBill {
  id                String         @id @default(uuid())
  companyId         String
  billNumber        String
  purchaseOrderId   String?
  supplierId        String
  status            DocumentStatus @default(DRAFT)
  billDate          DateTime       @default(now())
  dueDate           DateTime
  subtotal          Decimal        @default(0.00) @db.Decimal(15, 2)
  taxRate           Decimal        @default(0.00) @db.Decimal(5, 2)
  taxAmount         Decimal        @default(0.00) @db.Decimal(15, 2)
  totalAmount       Decimal        @default(0.00) @db.Decimal(15, 2)
  paidAmount        Decimal        @default(0.00) @db.Decimal(15, 2)
  outstandingAmount Decimal        @default(0.00) @db.Decimal(15, 2)
  notes             String?
  createdById       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier      Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  items         SupplierBillItem[]
  payments      SupplierPayment[]

  @@unique([companyId, billNumber])
  @@index([companyId, supplierId])
  @@index([companyId, status])
  @@index([companyId, dueDate])
  @@map("supplier_bills")
}

model SupplierBillItem {
  id             String  @id @default(uuid())
  supplierBillId String
  productId      String
  description    String?
  quantity       Decimal @db.Decimal(12, 2)
  unitCost       Decimal @db.Decimal(15, 2)
  total          Decimal @db.Decimal(15, 2)

  supplierBill SupplierBill @relation(fields: [supplierBillId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("supplier_bill_items")
}

model SupplierPayment {
  id              String        @id @default(uuid())
  companyId       String
  paymentNumber   String
  billId          String
  supplierId      String
  paymentMethod   PaymentMethod @default(BANK_TRANSFER)
  paymentDate     DateTime      @default(now())
  amount          Decimal       @db.Decimal(15, 2)
  referenceNumber String?
  notes           String?
  createdById     String?
  createdAt       DateTime      @default(now())

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bill     SupplierBill @relation(fields: [billId], references: [id], onDelete: Restrict)
  supplier Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@unique([companyId, paymentNumber])
  @@index([companyId, billId])
  @@index([companyId, supplierId])
  @@map("supplier_payments")
}

// ----------------------------------------------------
// Finance & Accounting Module (Double-Entry)
// ----------------------------------------------------

model Account {
  id           String         @id @default(uuid())
  companyId    String
  code         String
  name         String
  type         AccountType
  subtype      AccountSubType
  description  String?
  isReconciled Boolean        @default(false)
  balance      Decimal        @default(0.00) @db.Decimal(15, 2)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalEntryLines JournalEntryLine[]
  expenses          Expense[]

  @@unique([companyId, code])
  @@index([companyId, type])
  @@map("accounts")
}

model JournalEntry {
  id            String        @id @default(uuid())
  companyId     String
  entryNumber   String
  entryDate     DateTime      @default(now())
  referenceType String?       // SALES_INVOICE, SUPPLIER_BILL, PAYMENT, MANUAL, REVERSAL
  referenceId   String?
  description   String
  status        JournalStatus @default(DRAFT)
  totalDebit    Decimal       @default(0.00) @db.Decimal(15, 2)
  totalCredit   Decimal       @default(0.00) @db.Decimal(15, 2)
  reversedEntryId String?
  createdById   String?
  postedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   JournalEntryLine[]

  @@unique([companyId, entryNumber])
  @@index([companyId, status])
  @@index([companyId, entryDate])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String  @id @default(uuid())
  journalEntryId String
  accountId      String
  description    String?
  debit          Decimal @default(0.00) @db.Decimal(15, 2)
  credit         Decimal @default(0.00) @db.Decimal(15, 2)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_entry_lines")
}

model Expense {
  id              String         @id @default(uuid())
  companyId       String
  expenseNumber   String
  accountId       String
  category        String
  amount          Decimal        @db.Decimal(15, 2)
  paymentMethod   PaymentMethod  @default(BANK_TRANSFER)
  expenseDate     DateTime       @default(now())
  payee           String
  referenceNumber String?
  description     String?
  status          DocumentStatus @default(APPROVED)
  approvedById    String?
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([companyId, expenseNumber])
  @@index([companyId, expenseDate])
  @@map("expenses")
}

// ----------------------------------------------------
// Human Resources Module
// ----------------------------------------------------

model Department {
  id          String   @id @default(uuid())
  companyId   String
  code        String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees        Employee[]
  purchaseRequests PurchaseRequest[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("departments")
}

model Employee {
  id               String           @id @default(uuid())
  companyId        String
  employeeNumber   String
  firstName        String
  lastName         String
  email            String?
  phone            String?
  departmentId     String?
  jobTitle         String
  employmentStatus EmploymentStatus @default(PERMANENT)
  hireDate         DateTime         @default(now())
  terminationDate  DateTime?
  salary           Decimal?         @db.Decimal(15, 2)
  userId           String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department        Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  attendanceRecords AttendanceRecord[]
  leaveRequests     LeaveRequest[]

  @@unique([companyId, employeeNumber])
  @@index([companyId, departmentId])
  @@index([companyId, employmentStatus])
  @@map("employees")
}

model AttendanceRecord {
  id         String           @id @default(uuid())
  companyId  String
  employeeId String
  date       DateTime         @db.Date
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus @default(PRESENT)
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([companyId, employeeId, date])
  @@index([companyId, date])
  @@map("attendance_records")
}

model LeaveRequest {
  id          String      @id @default(uuid())
  companyId   String
  employeeId  String
  leaveType   LeaveType   @default(ANNUAL)
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  daysCount   Decimal     @db.Decimal(4, 1)
  reason      String
  status      LeaveStatus @default(PENDING)
  reviewedById String?
  reviewNotes String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
  @@index([companyId, status])
  @@map("leave_requests")
}
